              "@type": "Question",
              "name": "What is Scalogy?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Scalogy is an AI-native platform where Claude builds your business automations on a private server you own — apps, dashboards, scheduled workflows, webhooks, and custom-domain pages — without you writing code."
              }
            },
            {
              "@type": "Question",
              "name": "How much does Scalogy cost?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The Scalogy platform is $27 per month. You can build your own automations by talking to Claude, or pay for a Custom Install if you want us to build the first one for you."
              }
            },
            {
              "@type": "Question",
              "name": "Do I need to know how to code?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. You describe what you want in plain English and Claude builds it on your Scalogy server. No code, no drag-and-drop builder."
              }
            },
            {
              "@type": "Question",
              "name": "What can I build on Scalogy?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Apps, websites, scheduled workflows, webhooks, custom-domain pages, dashboards, and client portals — anything you can describe to Claude that runs on a Postgres + Python + web stack."
              }
            },
            {
              "@type": "Question",
              "name": "Do I own what gets built?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Everything Claude builds on your Scalogy server is yours — the data, the code, the settings. If you ever leave, you take it with you. No lock-in, no exit fees."
              }
            }
          ]
